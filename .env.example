# Postgres connection string (Supabase pooler). Leave empty to use local PGlite at .data/pglite.
DATABASE_URL=
# Telegram bot token used for restock/price alerts.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs that receive alerts.
TELEGRAM_CHAT_IDS=
# Public site URL; also sent in the crawler User-Agent.
SITE_URL=
# Secret key protecting the admin pages (/watchlist, /link-kr). At least 32 characters, or admin stays disabled.
ADMIN_KEY=
# Map tiles (public, inlined at build). Leave empty to use OpenStreetMap's public tiles, which are
# fine for development but NOT for heavy commercial traffic (OSM tile usage policy). Set a commercial
# provider before a public launch: https URL with {z}/{x}/{y}, plus its plain-text attribution.
NEXT_PUBLIC_MAP_TILE_URL=
NEXT_PUBLIC_MAP_TILE_ATTRIBUTION=
