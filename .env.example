# Postgres connection string (Supabase pooler). Leave empty to use local PGlite at .data/pglite.
DATABASE_URL=
# Telegram bot token used for restock/price alerts.
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram chat IDs that receive alerts.
TELEGRAM_CHAT_IDS=
# Public site URL; also sent in the crawler User-Agent.
SITE_URL=
# Secret key protecting admin/crawl endpoints.
ADMIN_KEY=
